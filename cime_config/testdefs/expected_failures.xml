<?xml version= "1.0"?>

<expectedFails version="1.1">

  <!-- Notes about the format of this file:

       The required elements for a given failure are just:

         <test name="...">
           <phase name="...">
             <status>...</status>
           </phase>
         </test>

       There can be multiple phase blocks in a given test block.

       In addition, a number of optional elements are allowed, which
       currently are just for human consumption (not parsed by any
       scripts):

       - A phase block can contain an "issue" element, which gives the
       issue number associated with this failure. (#123 refers to issue
       #123 in the ESCOMP/CAM-SIMA repository. Issues in other repositories
       should be specified as ORG/repo#123 - e.g., ESCOMP/atmospheric_physics#123.)

       - A phase block can contain a "comment" element, which gives any
       sort of comment you desire.

       This file is used by the cs.status.<test_id> script generated by
       test/system/test_driver.sh, which labels each failure listed here as
       "(EXPECTED FAILURE)".  A listed phase that does not have the listed
       status (e.g., one that now PASSes) is labeled "(UNEXPECTED: expected FAIL)",
       which means the entry should be updated or removed.

       To use this file with a cs.status script that was not generated by
       test_driver.sh, run:

         ./cs.status.<test_id> -x /path/to/CAM-SIMA/cime_config/testdefs/expected_failures.xml
  -->

  <!-- aux_sima test suite failures -->

  <test name="SMS_Ln9.ne3pg3_ne3pg3_mg37.FKESSLER.derecho_intel.cam-outfrq_se_cslam_multitape">
