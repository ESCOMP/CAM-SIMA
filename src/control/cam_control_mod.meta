  units = flag
  type = logical
  dimensions = ()
  protected = True
[ restart_run ]
  standard_name = is_restart_run
  long_name = Flag indicating whether this model simulation is a continuation of a previous run
  units = flag
  type = logical
  dimensions = ()
  protected = True
[ branch_run ]
  standard_name = is_branch_run
