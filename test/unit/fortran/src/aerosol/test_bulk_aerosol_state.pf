!-----------------------------------------------------------------------
! pFUnit tests for bulk_aerosol_state_mod.
!
! Tests the bulk aerosol state type, which extends abstract aerosol_state.
! Uses real bulk_aerosol_properties (via mock radiative_aerosol) to test
! the interaction between properties and state:
! mocking is done at the external dependency boundary (to avoid PIO at
! phys_prop)
!
! Mock boundaries:
!   - radiative_aerosol (rad_aer_get_info, rad_aer_get_props) for properties
!   - aerosol_mmr_host (rad_cnst_get_aer_mmr) for state MMR retrieval
!-----------------------------------------------------------------------

module test_bulk_aerosol_state
    use funit

    implicit none

    public
contains

@test
subroutine test_constructor()
    use funit
    use ccpp_kinds, only: kind_phys
    use bulk_aerosol_state_mod, only: bulk_aerosol_state
    use aerosol_mmr_host, only: aero_host_binding

    type(bulk_aerosol_state), pointer :: state
    real(kind_phys), allocatable, target :: constituents(:,:,:)
    real(kind_phys), pointer :: cptr(:,:,:)

    allocate(constituents(2, 3, 1))
    constituents = 1.0e-6_kind_phys
    cptr => constituents

    state => bulk_aerosol_state(2, aero_host_binding(cptr))

    @assertTrue(associated(state))

    deallocate(state)
    deallocate(constituents)
end subroutine test_constructor

@test
subroutine test_get_ambient_mmr()
    use funit
    use shr_kind_mod, only: r8 => shr_kind_r8
    use ccpp_kinds, only: kind_phys
    use bulk_aerosol_state_mod, only: bulk_aerosol_state
    use aerosol_mmr_host, only: aero_host_binding

    type(bulk_aerosol_state), pointer :: state
    real(kind_phys), allocatable, target :: constituents(:,:,:)
    real(kind_phys), pointer :: cptr(:,:,:)
    real(r8), pointer :: mmr(:,:)
    integer, parameter :: ncol = 2, nlev = 3, naero = 2

    allocate(constituents(ncol, nlev, naero))
    constituents(:, :, 1) = 1.0e-6_kind_phys  ! dust
    constituents(:, :, 2) = 2.0e-6_kind_phys  ! sulfate
    cptr => constituents

    state => bulk_aerosol_state(ncol, aero_host_binding(cptr))

    ! Get MMR for aerosol 1 (dust)
    call state%get_ambient_mmr(species_ndx=1, bin_ndx=1, mmr=mmr)
    @assertTrue(associated(mmr))
    @assertEqual(1.0e-6_r8, mmr(1, 1), 1.0e-20_r8)

    ! Get MMR for aerosol 2 (sulfate)
    call state%get_ambient_mmr(species_ndx=1, bin_ndx=2, mmr=mmr)
    @assertEqual(2.0e-6_r8, mmr(1, 1), 1.0e-20_r8)

    deallocate(state)
    deallocate(constituents)
end subroutine test_get_ambient_mmr

@test
subroutine test_dry_volume()
    use funit
    use shr_kind_mod, only: r8 => shr_kind_r8
    use ccpp_kinds, only: kind_phys
    use bulk_aerosol_state_mod, only: bulk_aerosol_state
    use aerosol_mmr_host, only: aero_host_binding
    use bulk_aerosol_properties_mod, only: bulk_aerosol_properties
    use radiative_aerosol, only: setup_mock_rad_aer, cleanup_mock_rad_aer

    type(bulk_aerosol_state), pointer :: state
    type(bulk_aerosol_properties), pointer :: props
    real(kind_phys), allocatable, target :: constituents(:,:,:)
    real(kind_phys), pointer :: cptr(:,:,:)
    real(r8) :: vol(1, 1)
    integer, parameter :: ncol = 1, nlev = 1, naero = 1

    ! Set up mock aerosol: density = 2000 kg/m3
    call setup_mock_rad_aer( &
         naero = naero, &
         density = [2000._r8], &
         hygro = [0.0_r8], &
         dispersion = [2.0_r8], &
         aername = [character(len=20) :: 'dust1'], &
         opticstype = [character(len=32) :: 'nonhygro'])

    props => bulk_aerosol_properties()

    ! Constituents: MMR = 1.0e-6 kg/kg
    allocate(constituents(ncol, nlev, naero))
    constituents(:, :, 1) = 1.0e-6_kind_phys
    cptr => constituents

    state => bulk_aerosol_state(ncol, aero_host_binding(cptr))

    ! dry_volume = mmr / density = 1e-6 / 2000 = 5e-10 m3/kg
    vol = state%dry_volume(props, bin_idx=1, ncol=ncol, nlev=nlev)
    @assertEqual(5.0e-10_r8, vol(1,1), 1.0e-24_r8)

    deallocate(state)
    deallocate(props)
    deallocate(constituents)
    call cleanup_mock_rad_aer()
end subroutine test_dry_volume

@test
subroutine test_ambient_total_bin_mmr()
    use funit
    use shr_kind_mod, only: r8 => shr_kind_r8
    use ccpp_kinds, only: kind_phys
    use bulk_aerosol_state_mod, only: bulk_aerosol_state
    use aerosol_mmr_host, only: aero_host_binding
    use bulk_aerosol_properties_mod, only: bulk_aerosol_properties
    use radiative_aerosol, only: setup_mock_rad_aer, cleanup_mock_rad_aer

    type(bulk_aerosol_state), pointer :: state
    type(bulk_aerosol_properties), pointer :: props
    real(kind_phys), allocatable, target :: constituents(:,:,:)
    real(kind_phys), pointer :: cptr(:,:,:)
    real(r8) :: mmr_tot
    integer, parameter :: ncol = 2, nlev = 3, naero = 2

    call setup_mock_rad_aer( &
         naero = naero, &
         density = [1000._r8, 1700._r8], &
         hygro = [0.0_r8, 0.5_r8], &
         dispersion = [2.0_r8, 1.6_r8], &
         aername = [character(len=20) :: 'dust1', 'sulfate'], &
         opticstype = [character(len=32) :: 'nonhygro', 'hygro'])

    props => bulk_aerosol_properties()

    allocate(constituents(ncol, nlev, naero))
    constituents(:, :, 1) = 3.0e-6_kind_phys
    constituents(:, :, 2) = 7.0e-6_kind_phys
    cptr => constituents

    state => bulk_aerosol_state(ncol, aero_host_binding(cptr))

    ! For bulk aerosols, each bin has 1 species, so total = that species
    mmr_tot = state%ambient_total_bin_mmr(props, bin_ndx=1, col_ndx=1, lyr_ndx=1)
    @assertEqual(3.0e-6_r8, mmr_tot, 1.0e-20_r8)

    mmr_tot = state%ambient_total_bin_mmr(props, bin_ndx=2, col_ndx=1, lyr_ndx=1)
    @assertEqual(7.0e-6_r8, mmr_tot, 1.0e-20_r8)

    deallocate(state)
    deallocate(props)
    deallocate(constituents)
    call cleanup_mock_rad_aer()
end subroutine test_ambient_total_bin_mmr

@test
subroutine test_surf_area_dens_sulfate()
    use funit
    use shr_kind_mod, only: r8 => shr_kind_r8
    use ccpp_kinds, only: kind_phys
    use bulk_aerosol_state_mod, only: bulk_aerosol_state
    use aerosol_mmr_host, only: aero_host_binding
    use bulk_aerosol_properties_mod, only: bulk_aerosol_properties
    use radiative_aerosol, only: setup_mock_rad_aer, cleanup_mock_rad_aer

    type(bulk_aerosol_state), pointer :: state
    type(bulk_aerosol_properties), pointer :: props
    real(kind_phys), allocatable, target :: constituents(:,:,:)
    real(kind_phys), pointer :: cptr(:,:,:)
    integer, parameter :: ncol = 2, nlev = 1, naero = 1
    real(r8), parameter :: pi = 3.14159265358979323846_r8

    ! Chin et al. sulfate lognormal parameters, duplicated from
    ! bulk_aerosol_state_mod on purpose so accidental changes to the science
    ! constants are caught here.
    real(r8), parameter :: rm_sulf  = 6.95e-6_r8  ! mean radius (cm)
    real(r8), parameter :: sd_sulf  = 2.03_r8     ! geometric std deviation
    real(r8), parameter :: rho_sulf = 1.7e3_r8    ! density (kg/m3)
    real(r8), parameter :: dm_sulf  = 2._r8*rm_sulf

    real(r8), parameter :: mmr_sulf = 5.0e-9_r8
    real(r8), parameter :: pmid_val = 90000._r8
    real(r8), parameter :: temp_val = 270._r8

    real(r8) :: relhum(ncol,nlev), pmid(ncol,nlev), temp(ncol,nlev)
    real(r8) :: sad(ncol,nlev), reff(ncol,nlev)
    real(r8) :: sfc(ncol,nlev,naero), dm_aer(ncol,nlev,naero)
    integer  :: beglev(ncol), endlev(ncol)
    real(r8) :: rho_air, vol, num, factor, rfac, expected(ncol)
    integer  :: i

    call setup_mock_rad_aer( &
         naero = naero, &
         density = [rho_sulf], &
         hygro = [0.5_r8], &
         dispersion = [sd_sulf], &
         aername = [character(len=20) :: 'sulfate'], &
         opticstype = [character(len=32) :: 'hygro'])

    props => bulk_aerosol_properties()

    allocate(constituents(ncol, nlev, naero))
    constituents(:, :, 1) = real(mmr_sulf, kind_phys)
    cptr => constituents

    state => bulk_aerosol_state(ncol, aero_host_binding(cptr))

    beglev = 1
    endlev = nlev
    pmid = pmid_val
    temp = temp_val
    relhum(1,1) = 0.85_r8   ! interpolated between table points 0.8 and 0.9
    relhum(2,1) = 0.995_r8  ! above the last table point: clamped growth factor

    call state%surf_area_dens(props, [character(len=32) :: 'sulfate'], &
         ncol, nlev, beglev, endlev, relhum, pmid, temp, pi, sad, reff, &
         sfc=sfc, dm_aer=dm_aer)

    ! Expected SAD from the lognormal surface area of a distribution whose
    ! number density is derived from the dry volume mixing ratio, with the
    ! wet diameter grown by the RH factor from the Chin et al. table.
    rho_air = pmid_val/(temp_val*287.04_r8)
    vol = mmr_sulf*rho_air/rho_sulf
    num = vol*(6._r8/pi)*(1._r8/dm_sulf**3)*exp(-4.5_r8*log(sd_sulf)**2)
    do i = 1, ncol
       if (relhum(i,1) >= 0.99_r8) then
          rfac = 2.2_r8
       else
          factor = (relhum(i,1) - 0.8_r8)/(0.9_r8 - 0.8_r8)
          rfac = 1.6_r8 + factor*(1.8_r8 - 1.6_r8)
       end if
       expected(i) = num*pi*(dm_sulf*rfac)**2*exp(2._r8*log(sd_sulf)**2)
    end do

    @assertEqual(expected(1), sad(1,1), abs(expected(1))*1.0e-12_r8)
    @assertEqual(expected(2), sad(2,1), abs(expected(2))*1.0e-12_r8)

    ! bulk surf_area_dens never computes an effective radius
    @assertEqual(0._r8, reff(1,1))
    @assertEqual(0._r8, reff(2,1))

    ! per-bin surface area and wet diameter diagnostics
    @assertEqual(sad(1,1), sfc(1,1,1))
    @assertEqual(dm_sulf*1.7_r8, dm_aer(1,1,1), dm_sulf*1.0e-12_r8)
    @assertEqual(dm_sulf*2.2_r8, dm_aer(2,1,1), dm_sulf*1.0e-12_r8)

    deallocate(state)
    deallocate(props)
    deallocate(constituents)
    call cleanup_mock_rad_aer()
end subroutine test_surf_area_dens_sulfate

@test
subroutine test_surf_area_dens_gating()
    use funit
    use shr_kind_mod, only: r8 => shr_kind_r8
    use ccpp_kinds, only: kind_phys
    use bulk_aerosol_state_mod, only: bulk_aerosol_state
    use aerosol_mmr_host, only: aero_host_binding
    use bulk_aerosol_properties_mod, only: bulk_aerosol_properties
    use radiative_aerosol, only: setup_mock_rad_aer, cleanup_mock_rad_aer

    type(bulk_aerosol_state), pointer :: state
    type(bulk_aerosol_properties), pointer :: props
    real(kind_phys), allocatable, target :: constituents(:,:,:)
    real(kind_phys), pointer :: cptr(:,:,:)
    integer, parameter :: ncol = 1, nlev = 2, naero = 3
    real(r8), parameter :: pi = 3.14159265358979323846_r8

    ! Chin et al. parameters (see note in test_surf_area_dens_sulfate).
    ! The number density exponent uses the sulfate standard deviation for all
    ! species types; the surface area exponent uses the per-type value.
    real(r8), parameter :: sd_sulf = 2.03_r8
    real(r8), parameter :: rm_bc   = 1.18e-6_r8
    real(r8), parameter :: sd_bc   = 2.00_r8
    real(r8), parameter :: rho_bc  = 1.0e3_r8
    real(r8), parameter :: dm_bc   = 2._r8*rm_bc

    real(r8), parameter :: mmr_bcphi = 4.0e-9_r8
    real(r8), parameter :: pmid_val = 90000._r8
    real(r8), parameter :: temp_val = 270._r8

    real(r8) :: relhum(ncol,nlev), pmid(ncol,nlev), temp(ncol,nlev)
    real(r8) :: sad(ncol,nlev), reff(ncol,nlev)
    real(r8) :: sfc(ncol,nlev,naero), dm_aer(ncol,nlev,naero)
    integer  :: beglev(ncol), endlev(ncol)
    real(r8) :: rho_air, vol, num, factor, rfac_bc, expected

    ! Three bins: hydrophilic BC (contributes), hydrophobic BC (skipped by
    ! the hydrophilic() gate), hydrophilic OC (skipped: not in types_list).
    call setup_mock_rad_aer( &
         naero = naero, &
         density = [rho_bc, rho_bc, 1.8e3_r8], &
         hygro = [0.1_r8, 0.0_r8, 0.2_r8], &
         dispersion = [sd_bc, sd_bc, 2.20_r8], &
         aername = [character(len=20) :: 'bcphi', 'bcpho', 'ocphi'], &
         opticstype = [character(len=32) :: 'hygro', 'insoluble', 'hygro'])

    props => bulk_aerosol_properties()

    allocate(constituents(ncol, nlev, naero))
    constituents(:, :, 1) = real(mmr_bcphi, kind_phys)
    constituents(:, :, 2) = 8.0e-9_kind_phys
    constituents(:, :, 3) = 16.0e-9_kind_phys
    cptr => constituents

    state => bulk_aerosol_state(ncol, aero_host_binding(cptr))

    ! restrict the computation to level 2: level 1 must stay zero
    beglev = 2
    endlev = 2
    pmid = pmid_val
    temp = temp_val
    relhum = 0.85_r8

    call state%surf_area_dens(props, [character(len=32) :: 'black-c'], &
         ncol, nlev, beglev, endlev, relhum, pmid, temp, pi, sad, reff, &
         sfc=sfc, dm_aer=dm_aer)

    ! level 1 is outside beglev/endlev
    @assertEqual(0._r8, sad(1,1))
    @assertEqual(0._r8, sfc(1,1,1))

    ! Only the hydrophilic BC bin contributes.  The BC growth factor at
    ! RH=0.85 interpolates the table from the lower point: 1.2 + 0.5*(1.4-1.2)
    ! = 1.3.  This also guards the fix of the long-standing CAM bug that
    ! interpolated rfac_bc/rfac_oc from the upper point (giving 1.5 here).
    rho_air = pmid_val/(temp_val*287.04_r8)
    vol = mmr_bcphi*rho_air/rho_bc
    num = vol*(6._r8/pi)*(1._r8/dm_bc**3)*exp(-4.5_r8*log(sd_sulf)**2)
    factor = (0.85_r8 - 0.8_r8)/(0.9_r8 - 0.8_r8)
    rfac_bc = 1.2_r8 + factor*(1.4_r8 - 1.2_r8)
    expected = num*pi*(dm_bc*rfac_bc)**2*exp(2._r8*log(sd_bc)**2)

    @assertEqual(expected, sad(1,2), abs(expected)*1.0e-12_r8)
    @assertEqual(sad(1,2), sfc(1,2,1))
    @assertEqual(dm_bc*rfac_bc, dm_aer(1,2,1), dm_bc*1.0e-12_r8)

    ! excluded bins left no per-bin contributions
    @assertEqual(0._r8, sfc(1,2,2))
    @assertEqual(0._r8, sfc(1,2,3))

    deallocate(state)
    deallocate(props)
    deallocate(constituents)
    call cleanup_mock_rad_aer()
end subroutine test_surf_area_dens_gating

end module test_bulk_aerosol_state
