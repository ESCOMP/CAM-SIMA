!-----------------------------------------------------------------------
! pFUnit tests for modal_aerosol_state_mod.
!
! Uses the same 2-mode MAM config as modal_aerosol_properties tests:
!   Mode 1 "accum": 2 species (sulfate, black-c)
!   Mode 2 "coarse": 1 species (dust)
!
! Constituent flat layout (5 entries):
!   Index 1: num_a1  (mode 1 number)
!   Index 2: so4_a1  (mode 1 sulfate MMR)
!   Index 3: bc_a1   (mode 1 black-c MMR)
!   Index 4: num_a2  (mode 2 number)
!   Index 5: dst_a2  (mode 2 dust MMR)
!
! Mock boundaries:
!   - radiative_aerosol (modal mock interfaces) for properties
!   - aerosol_mmr_host (modal overloads) for state MMR retrieval
!-----------------------------------------------------------------------

module test_modal_aerosol_state
    use funit

    implicit none

    public
contains

@test
subroutine test_get_ambient_mmr()
    use funit
    use shr_kind_mod, only: r8 => shr_kind_r8
    use ccpp_kinds, only: kind_phys
    use modal_aerosol_state_mod, only: modal_aerosol_state
    use aerosol_mmr_host, only: aero_host_binding
    use radiative_aerosol, only: cleanup_mock_rad_aer
    use modal_test_helpers, only: setup_2mode_mock

    type(modal_aerosol_state), pointer :: state
    real(kind_phys), allocatable, target :: constituents(:,:,:)
    real(kind_phys), pointer :: cptr(:,:,:)
    real(r8), pointer :: mmr(:,:)
    integer, parameter :: ncol = 2, nlev = 3, ncnst = 5

    call setup_2mode_mock()

    allocate(constituents(ncol, nlev, ncnst))
    constituents = 0._kind_phys
    ! Index 2: so4_a1 (mode 1, species 1)
    constituents(:, :, 2) = 1.0e-9_kind_phys
    ! Index 3: bc_a1 (mode 1, species 2)
    constituents(:, :, 3) = 2.0e-9_kind_phys
    ! Index 5: dst_a2 (mode 2, species 1)
    constituents(:, :, 5) = 5.0e-9_kind_phys
    cptr => constituents

    state => modal_aerosol_state(ncol, aero_host_binding(cptr))

    ! get_ambient_mmr(species_ndx=1, bin_ndx=1) -> so4_a1 at index 2
    call state%get_ambient_mmr(species_ndx=1, bin_ndx=1, mmr=mmr)
    @assertTrue(associated(mmr))
    @assertEqual(1.0e-9_r8, mmr(1, 1), 1.0e-20_r8)

    ! get_ambient_mmr(species_ndx=2, bin_ndx=1) -> bc_a1 at index 3
    call state%get_ambient_mmr(species_ndx=2, bin_ndx=1, mmr=mmr)
    @assertEqual(2.0e-9_r8, mmr(1, 1), 1.0e-20_r8)

    ! get_ambient_mmr(species_ndx=1, bin_ndx=2) -> dst_a2 at index 5
    call state%get_ambient_mmr(species_ndx=1, bin_ndx=2, mmr=mmr)
    @assertEqual(5.0e-9_r8, mmr(1, 1), 1.0e-20_r8)

    deallocate(state)
    deallocate(constituents)
    call cleanup_mock_rad_aer()
end subroutine test_get_ambient_mmr

@test
subroutine test_get_ambient_num()
    use funit
    use shr_kind_mod, only: r8 => shr_kind_r8
    use ccpp_kinds, only: kind_phys
    use modal_aerosol_state_mod, only: modal_aerosol_state
    use aerosol_mmr_host, only: aero_host_binding
    use radiative_aerosol, only: cleanup_mock_rad_aer
    use modal_test_helpers, only: setup_2mode_mock

    type(modal_aerosol_state), pointer :: state
    real(kind_phys), allocatable, target :: constituents(:,:,:)
    real(kind_phys), pointer :: cptr(:,:,:)
    real(r8), pointer :: num(:,:)
    integer, parameter :: ncol = 2, nlev = 3, ncnst = 5

    call setup_2mode_mock()

    allocate(constituents(ncol, nlev, ncnst))
    constituents = 0._kind_phys
    ! Index 1: num_a1 (mode 1 number)
    constituents(:, :, 1) = 1.0e8_kind_phys
    ! Index 4: num_a2 (mode 2 number)
    constituents(:, :, 4) = 5.0e6_kind_phys
    cptr => constituents

    state => modal_aerosol_state(ncol, aero_host_binding(cptr))

    ! get_ambient_num(bin_ndx=1) -> index 1
    call state%get_ambient_num(bin_ndx=1, num=num)
    @assertTrue(associated(num))
    @assertEqual(1.0e8_r8, num(1, 1), 1.0e-5_r8)

    ! get_ambient_num(bin_ndx=2) -> index 4
    call state%get_ambient_num(bin_ndx=2, num=num)
    @assertEqual(5.0e6_r8, num(1, 1), 1.0e-5_r8)

    deallocate(state)
    deallocate(constituents)
    call cleanup_mock_rad_aer()
end subroutine test_get_ambient_num

@test
subroutine test_ambient_total_bin_mmr()
    use funit
    use shr_kind_mod, only: r8 => shr_kind_r8
    use ccpp_kinds, only: kind_phys
    use modal_aerosol_state_mod, only: modal_aerosol_state
    use aerosol_mmr_host, only: aero_host_binding
    use modal_aerosol_properties_mod, only: modal_aerosol_properties
    use radiative_aerosol, only: cleanup_mock_rad_aer
    use modal_test_helpers, only: setup_2mode_mock

    type(modal_aerosol_state), pointer :: state
    type(modal_aerosol_properties), pointer :: props
    real(kind_phys), allocatable, target :: constituents(:,:,:)
    real(kind_phys), pointer :: cptr(:,:,:)
    real(r8) :: mmr_tot
    integer, parameter :: ncol = 2, nlev = 3, ncnst = 5

    call setup_2mode_mock()

    allocate(constituents(ncol, nlev, ncnst))
    constituents = 0._kind_phys
    ! Mode 1: so4_a1 = 1e-9, bc_a1 = 2e-9
    constituents(:, :, 2) = 1.0e-9_kind_phys
    constituents(:, :, 3) = 2.0e-9_kind_phys
    cptr => constituents

    props => modal_aerosol_properties()
    state => modal_aerosol_state(ncol, aero_host_binding(cptr))

    ! Total for mode 1 at (col=1, lyr=1): so4 + bc = 3e-9
    mmr_tot = state%ambient_total_bin_mmr(props, bin_ndx=1, col_ndx=1, lyr_ndx=1)
    @assertEqual(3.0e-9_r8, mmr_tot, 1.0e-20_r8)

    deallocate(state)
    deallocate(props)
    deallocate(constituents)
    call cleanup_mock_rad_aer()
end subroutine test_ambient_total_bin_mmr

@test
subroutine test_dry_volume()
    use funit
    use shr_kind_mod, only: r8 => shr_kind_r8
    use ccpp_kinds, only: kind_phys
    use modal_aerosol_state_mod, only: modal_aerosol_state
    use aerosol_mmr_host, only: aero_host_binding
    use modal_aerosol_properties_mod, only: modal_aerosol_properties
    use radiative_aerosol, only: cleanup_mock_rad_aer
    use modal_test_helpers, only: setup_2mode_mock, dens_sulfate, dens_bc

    type(modal_aerosol_state), pointer :: state
    type(modal_aerosol_properties), pointer :: props
    real(kind_phys), allocatable, target :: constituents(:,:,:)
    real(kind_phys), pointer :: cptr(:,:,:)
    real(r8), allocatable :: vol(:,:)
    real(r8) :: expected
    real(r8) :: mmr_so4, mmr_bc
    integer, parameter :: ncol = 2, nlev = 3, ncnst = 5

    call setup_2mode_mock()

    mmr_so4 = 1.0e-9_r8
    mmr_bc  = 2.0e-9_r8

    allocate(constituents(ncol, nlev, ncnst))
    constituents = 0._kind_phys
    constituents(:, :, 2) = real(mmr_so4, kind_phys)
    constituents(:, :, 3) = real(mmr_bc, kind_phys)
    cptr => constituents

    props => modal_aerosol_properties()
    state => modal_aerosol_state(ncol, aero_host_binding(cptr))

    ! dry_volume for mode 1 = sum(mmr_i / density_i)
    expected = mmr_so4 / dens_sulfate + mmr_bc / dens_bc

    allocate(vol(ncol, nlev))
    vol = state%dry_volume(props, bin_idx=1, ncol=ncol, nlev=nlev)

    @assertEqual(expected, vol(1, 1), abs(expected) * 1.0e-12_r8)

    deallocate(vol)
    deallocate(state)
    deallocate(props)
    deallocate(constituents)
    call cleanup_mock_rad_aer()
end subroutine test_dry_volume

@test
subroutine test_surf_area_dens()
    use funit
    use shr_kind_mod, only: r8 => shr_kind_r8
    use ccpp_kinds, only: kind_phys
    use modal_aerosol_state_mod, only: modal_aerosol_state
    use aerosol_mmr_host, only: aero_host_binding
    use modal_aerosol_properties_mod, only: modal_aerosol_properties
    use radiative_aerosol, only: cleanup_mock_rad_aer
    use modal_test_helpers, only: setup_2mode_mock, sigmag_accum
    use physics_types, only: dgncur_awet

    type(modal_aerosol_state), pointer :: state
    type(modal_aerosol_properties), pointer :: props
    real(kind_phys), allocatable, target :: constituents(:,:,:)
    real(kind_phys), pointer :: cptr(:,:,:)
    integer, parameter :: ncol = 1, nlev = 1, ncnst = 5, nmodes = 2
    real(r8), parameter :: pi = 3.14159265358979323846_r8

    real(r8), parameter :: mmr_so4 = 1.0e-9_r8
    real(r8), parameter :: mmr_bc  = 2.0e-9_r8
    real(r8), parameter :: num_a1  = 3.0e8_r8   ! mode 1 number (#/kg)
    real(r8), parameter :: diam1   = 0.15e-6_r8 ! mode 1 wet diameter (m)
    real(r8), parameter :: diam2   = 2.5e-6_r8  ! mode 2 wet diameter (m)
    real(r8), parameter :: pmid_val = 80000._r8
    real(r8), parameter :: temp_val = 260._r8

    real(r8) :: relhum(ncol,nlev), pmid(ncol,nlev), temp(ncol,nlev)
    real(r8) :: sad(ncol,nlev), reff(ncol,nlev)
    real(r8) :: sfc(ncol,nlev,nmodes), dm_aer(ncol,nlev,nmodes)
    integer  :: beglev(ncol), endlev(ncol)
    real(r8) :: rho_air, alogsig, wght, sad_expected, vol_expected

    call setup_2mode_mock()

    allocate(constituents(ncol, nlev, ncnst))
    constituents = 0._kind_phys
    constituents(:, :, 1) = real(num_a1, kind_phys)   ! num_a1
    constituents(:, :, 2) = real(mmr_so4, kind_phys)  ! so4_a1
    constituents(:, :, 3) = real(mmr_bc, kind_phys)   ! bc_a1
    constituents(:, :, 4) = 1.0e6_kind_phys           ! num_a2
    constituents(:, :, 5) = 5.0e-9_kind_phys          ! dst_a2
    cptr => constituents

    allocate(dgncur_awet(ncol, nlev, nmodes))
    dgncur_awet(:, :, 1) = real(diam1, kind_phys)
    dgncur_awet(:, :, 2) = real(diam2, kind_phys)

    props => modal_aerosol_properties()
    state => modal_aerosol_state(ncol, aero_host_binding(cptr))

    beglev = 1
    endlev = nlev
    pmid = pmid_val
    temp = temp_val
    relhum = 0.5_r8

    ! only sulfate counts toward the surface area; bc still contributes to
    ! the mode mass used for the number weighting
    call state%surf_area_dens(props, [character(len=32) :: 'sulfate'], &
         ncol, nlev, beglev, endlev, relhum, pmid, temp, pi, sad, reff, &
         sfc=sfc, dm_aer=dm_aer)

    ! Expected mode 1 surface area of a lognormal distribution with the wet
    ! diameter as geometric mean, mass-weighted by the in-list fraction.
    rho_air = pmid_val/(temp_val*287.04_r8)
    alogsig = log(sigmag_accum)
    wght = mmr_so4/(mmr_so4 + mmr_bc)
    sad_expected = 1.e-2_r8*wght*num_a1*rho_air*pi*diam1**2*exp(2._r8*alogsig**2)
    vol_expected = wght*num_a1*rho_air*pi/6._r8*diam1**3*exp(4.5_r8*alogsig**2)

    @assertEqual(sad_expected, sad(1,1), abs(sad_expected)*1.0e-12_r8)
    @assertEqual(3._r8*vol_expected/sad_expected, reff(1,1), abs(3._r8*vol_expected/sad_expected)*1.0e-12_r8)

    ! mode 2 (dust) has no in-list species: zero contribution
    @assertEqual(sad(1,1), sfc(1,1,1))
    @assertEqual(0._r8, sfc(1,1,2))

    ! per-mode wet diameters are returned converted from m to cm
    @assertEqual(diam1*1.e2_r8, dm_aer(1,1,1), diam1*1.0e-12_r8)
    @assertEqual(diam2*1.e2_r8, dm_aer(1,1,2), diam2*1.0e-12_r8)

    deallocate(dgncur_awet)
    deallocate(state)
    deallocate(props)
    deallocate(constituents)
    call cleanup_mock_rad_aer()
end subroutine test_surf_area_dens

@test
subroutine test_surf_area_dens_mode_gating()
    use funit
    use shr_kind_mod, only: r8 => shr_kind_r8
    use ccpp_kinds, only: kind_phys
    use modal_aerosol_state_mod, only: modal_aerosol_state
    use aerosol_mmr_host, only: aero_host_binding
    use modal_aerosol_properties_mod, only: modal_aerosol_properties
    use radiative_aerosol, only: setup_mock_modal_rad_aer, cleanup_mock_rad_aer
    use physics_types, only: dgncur_awet

    type(modal_aerosol_state), pointer :: state
    type(modal_aerosol_properties), pointer :: props
    real(kind_phys), allocatable, target :: constituents(:,:,:)
    real(kind_phys), pointer :: cptr(:,:,:)
    integer, parameter :: ncol = 1, nlev = 1, ncnst = 6, nmodes = 3
    real(r8), parameter :: pi = 3.14159265358979323846_r8

    real(r8), parameter :: mmr_so4_2 = 2.0e-9_r8
    real(r8), parameter :: num_a2    = 5.0e7_r8
    real(r8), parameter :: diam2     = 0.2e-6_r8
    real(r8), parameter :: sigmag2   = 1.8_r8
    real(r8), parameter :: pmid_val = 100000._r8
    real(r8), parameter :: temp_val = 280._r8

    real(r8) :: relhum(ncol,nlev), pmid(ncol,nlev), temp(ncol,nlev)
    real(r8) :: sad(ncol,nlev), reff(ncol,nlev)
    real(r8) :: sfc(ncol,nlev,nmodes)
    integer  :: beglev(ncol), endlev(ncol)
    real(r8) :: rho_air, alogsig, sad_expected
    character(len=32) :: spec_type(nmodes,1), spec_name(nmodes,1), spec_name_cw(nmodes,1)
    real(r8) :: spec_density(nmodes,1), spec_hygro(nmodes,1)

    ! Three single-species modes:
    !   mode 1 "primary_carbon": has in-list mass but is always excluded
    !   mode 2 "accum": in-list sulfate, the only contributor
    !   mode 3 "aitken": zero mass, exercises the tot_mass == 0 branch
    spec_type(1,1) = 'black-c'
    spec_type(2,1) = 'sulfate'
    spec_type(3,1) = 'sulfate'
    spec_name(1,1) = 'bc_a1'
    spec_name(2,1) = 'so4_a2'
    spec_name(3,1) = 'so4_a3'
    spec_name_cw(1,1) = 'bc_c1'
    spec_name_cw(2,1) = 'so4_c2'
    spec_name_cw(3,1) = 'so4_c3'
    spec_density(:,1) = [1700._r8, 1770._r8, 1770._r8]
    spec_hygro(:,1) = [1.0e-10_r8, 0.507_r8, 0.507_r8]

    call setup_mock_modal_rad_aer( &
         nmodes = nmodes, &
         nspec = [1, 1, 1], &
         mode_type = [character(len=32) :: 'primary_carbon', 'accum', 'aitken'], &
         num_name = [character(len=32) :: 'num_a1', 'num_a2', 'num_a3'], &
         num_name_cw = [character(len=32) :: 'num_c1', 'num_c2', 'num_c3'], &
         sigmag = [1.6_r8, sigmag2, 1.6_r8], &
         dgnum = [0.05e-6_r8, 0.11e-6_r8, 0.02e-6_r8], &
         dgnumlo = [0.005e-6_r8, 0.011e-6_r8, 0.002e-6_r8], &
         dgnumhi = [0.5e-6_r8, 1.1e-6_r8, 0.2e-6_r8], &
         rhcrystal = [0.35_r8, 0.35_r8, 0.35_r8], &
         rhdeliques = [0.80_r8, 0.80_r8, 0.80_r8], &
         spec_type = spec_type, &
         spec_name = spec_name, &
         spec_name_cw = spec_name_cw, &
         spec_density = spec_density, &
         spec_hygro = spec_hygro)

    ! flat layout: num_a1, bc_a1, num_a2, so4_a2, num_a3, so4_a3
    allocate(constituents(ncol, nlev, ncnst))
    constituents = 0._kind_phys
    constituents(:, :, 1) = 1.0e8_kind_phys            ! num_a1
    constituents(:, :, 2) = 1.0e-9_kind_phys           ! bc_a1
    constituents(:, :, 3) = real(num_a2, kind_phys)    ! num_a2
    constituents(:, :, 4) = real(mmr_so4_2, kind_phys) ! so4_a2
    constituents(:, :, 5) = 1.0e9_kind_phys            ! num_a3
    ! so4_a3 stays zero
    cptr => constituents

    allocate(dgncur_awet(ncol, nlev, nmodes))
    dgncur_awet(:, :, 1) = 0.1e-6_kind_phys
    dgncur_awet(:, :, 2) = real(diam2, kind_phys)
    dgncur_awet(:, :, 3) = 0.05e-6_kind_phys

    props => modal_aerosol_properties()
    state => modal_aerosol_state(ncol, aero_host_binding(cptr))

    beglev = 1
    endlev = nlev
    pmid = pmid_val
    temp = temp_val
    relhum = 0.5_r8

    call state%surf_area_dens(props, &
         [character(len=32) :: 'sulfate', 'black-c'], &
         ncol, nlev, beglev, endlev, relhum, pmid, temp, pi, sad, reff, sfc=sfc)

    ! only mode 2 contributes, with the full mode mass in-list
    rho_air = pmid_val/(temp_val*287.04_r8)
    alogsig = log(sigmag2)
    sad_expected = 1.e-2_r8*num_a2*rho_air*pi*diam2**2*exp(2._r8*alogsig**2)

    @assertEqual(sad_expected, sad(1,1), abs(sad_expected)*1.0e-12_r8)
    @assertEqual(0._r8, sfc(1,1,1))
    @assertEqual(sad(1,1), sfc(1,1,2))
    @assertEqual(0._r8, sfc(1,1,3))

    deallocate(dgncur_awet)
    deallocate(state)
    deallocate(props)
    deallocate(constituents)
    call cleanup_mock_rad_aer()
end subroutine test_surf_area_dens_mode_gating

end module test_modal_aerosol_state
